meta {
  name: Missing token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "itemId": 1,
    "quantity": 1
  }
}

tests {
  test("Response is JSON", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
  });

  test("HTTP status is 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("Error body describes rejection", function () {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.equal("Unauthorized");
  });
}
