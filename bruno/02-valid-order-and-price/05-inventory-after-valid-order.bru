meta {
  name: Inventory after valid order
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/menu
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Response is JSON", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
  });

  test("HTTP status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Only ordered stock decreases by quantity", function () {
    const expected = JSON.parse(JSON.stringify(bru.getVar('menuBefore')));
    expected.find(item => item.id === 1).stock -= 1;
    expect(res.getBody()).to.deep.equal(expected);
  });

  test("Inventory never becomes negative", function () {
    res.getBody().forEach(item => expect(item.stock).to.be.at.least(0));
  });
}
